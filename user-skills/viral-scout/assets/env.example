# Copy to ~/.config/viral-scout/.env and fill in. File is gitignored.

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Firecrawl — https://firecrawl.dev
FIRECRAWL_API_KEY=

# Whisper.cpp model path (downloaded by setup script)
WHISPER_MODEL_PATH=/Users/jo/.local/share/whisper-models/ggml-large-v3.bin

# Optional — Whisper API fallback if whisper.cpp fails
OPENAI_API_KEY=

# Optional — Apify TikTok/Instagram scrapers (only if --use-apify)
APIFY_API_TOKEN=

# HeyGen — https://app.heygen.com/settings?nav=API
# Required for scripts/heygen_render.py (Avatar IV / talking-photo lip-sync renders)
HEYGEN_API_KEY=
